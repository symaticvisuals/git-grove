{
  "name": "git-grove",
  "version": "0.1.0",
  "description": "Watches git worktrees and stacked branches, pins every tip it sees replaced, and stops a worktree removal that would lose work",
  "keywords": [
    "git",
    "worktree",
    "stacked-branches",
    "rebase",
    "squash",
    "ai-agents",
    "safety"
  ],
  "homepage": "https://github.com/symaticvisuals/git-grove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/symaticvisuals/git-grove.git"
  },
  "bugs": {
    "url": "https://github.com/symaticvisuals/git-grove/issues"
  },
  "license": "MIT",
  "author": "symaticvisuals",
  "type": "module",
  "bin": {
    "git-grove": "dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli/bin.js', 0o755)\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p ui/tsconfig.json && tsc -p ui/sw.tsconfig.json",
    "demo": "bash scripts/demo.sh",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
