{
  "name": "git-grove",
  "version": "0.1.0",
  "description": "Watches git worktrees and stacked branches",
  "type": "module",
  "bin": {
    "git-grove": "dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli/bin.js', 0o755)\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p ui/tsconfig.json",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
